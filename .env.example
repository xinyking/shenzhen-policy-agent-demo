# Set these environment variables explicitly; .env is not loaded automatically.
POLICY_MODEL_BASE_URL=https://your-provider.example/v1
POLICY_MODEL_NAME=your-model
POLICY_MODEL_API_KEY=replace-me
# Optional visual model on the same endpoint/key; defaults to POLICY_MODEL_NAME.
# POLICY_VISION_MODEL_NAME=your-vision-model
# Optional API project root:
# POLICY_PROJECT_ROOT=/absolute/path/to/shenzhen-policy-agent-demo

# Optional Tavily fallback; local private search-config.json is also supported.
TAVILY_API_KEY=
